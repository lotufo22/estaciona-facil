@startuml
title Renovar contrato - Diagrama de sequência (com códigos HTTP)

actor "Proprietário" as PROP
participant "Tela (HTML)" as TELA
participant "Controlador (PHP)" as CTL
database "Banco (MySQL)" as DB

PROP -> TELA : Seleciona o mensalista
activate TELA
TELA -> CTL : GET /contratos
activate CTL

CTL -> DB : consulta contrato
activate DB
DB --> CTL : contrato e vigência
deactivate DB

' sem deactivate dentro do break: as barras seguem pelo restante do fluxo
break contrato inexistente ou encerrado
  CTL --> TELA : 404 Not Found
  TELA --> PROP : exibe erro
end

CTL --> TELA : 200 OK + contrato
deactivate CTL

PROP -> TELA : Confirma a renovação
TELA -> CTL : PATCH /contratos/{id}
activate CTL

CTL -> CTL : calcularNovaVigência()
activate CTL
deactivate CTL

CTL -> DB : atualiza vigência
activate DB
DB --> CTL : ok
deactivate DB

CTL -> DB : registra histórico
activate DB
DB --> CTL : ok
deactivate DB

CTL --> TELA : 200 OK
deactivate CTL
TELA --> PROP : exibe nova vigência
deactivate TELA
@enduml
