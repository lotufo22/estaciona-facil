# Copie para .env e preencha. Nunca faça commit do .env.

# Banco de dados (Supabase). Em produção a função usa o pooler em modo transação;
# as migrações usam o pooler em modo sessão.
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL_MIGRACAO=postgresql://usuario:senha@host:5432/postgres

# Banco usado pelos testes da API (Postgres real, com dados descartáveis)
DATABASE_URL_TESTE=postgresql://usuario:senha@localhost:5432/estaciona_teste

# Front-end: 1 liga os dados de exemplo (Mock Service Worker)
VITE_USAR_MOCKS=1
